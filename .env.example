# Place a real BotFather token ONLY in a local/private .env file.
BOT_TOKEN=replace-with-private-token
# Used by a local run; on server deploy it is set to the commit SHA.
BOR_BUILD_SHA=local
BOR_CAPTCHA_SECONDS=120
BOR_CAPTCHA_ATTEMPTS=3
# Numeric ID of your isolated test supergroup; only for read-only preflight.
BOR_TEST_CHAT_ID=
